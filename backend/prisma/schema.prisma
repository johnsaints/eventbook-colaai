generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ORGANIZER
  STAFF
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedEvents  Event[]      @relation("OrganizerEvents")
  orders           Order[]
  staffAssignments EventStaff[]
  checkIns         CheckIn[]

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String      @db.Text
  location    String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  status      EventStatus @default(DRAFT)
  organizerId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer User         @relation("OrganizerEvents", fields: [organizerId], references: [id])
  lots      TicketLot[]
  orders    Order[]
  tickets   Ticket[]
  staff     EventStaff[]

  @@index([status, startsAt])
  @@map("events")
}

model TicketLot {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  price         Decimal  @db.Decimal(10, 2)
  totalQuantity Int
  soldQuantity  Int      @default(0)
  reservedQty   Int      @default(0)
  salesStartsAt DateTime
  salesEndsAt   DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_lots")
}

model EventStaff {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_staff")
}

model Order {
  id          String      @id @default(uuid())
  buyerId     String
  eventId     String
  totalAmount Decimal     @db.Decimal(20, 2)
  status      OrderStatus @default(PENDING)
  expiresAt   DateTime // RN-04: Reserva expira em 15 minutos
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer   User        @relation(fields: [buyerId], references: [id])
  event   Event       @relation(fields: [eventId], references: [id])
  items   OrderItem[]
  tickets Ticket[]

  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  lotId             String
  quantity          Int
  unitPriceSnapshot Decimal @db.Decimal(10, 2)

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lot   TicketLot @relation(fields: [lotId], references: [id])

  @@unique([orderId, lotId])
  @@index([lotId])
  @@map("order_items")
}

model Ticket {
  id        String       @id @default(uuid())
  code      String       @unique
  orderId   String
  eventId   String
  lotId     String
  status    TicketStatus @default(VALID)
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event Event     @relation(fields: [eventId], references: [id])
  lot   TicketLot @relation(fields: [lotId], references: [id])

  checkIn CheckIn?

  @@index([eventId, code])
  @@map("tickets")
}

model CheckIn {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  staffId     String
  checkedInAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  staff  User   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@map("checkins")
}
